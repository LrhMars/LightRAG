# =============================================================================
# LightRAG 环境变量 — Docker 部署（compose 挂载本文件）
# - LLM：远端 OpenAI 兼容服务（已探测 117.88.244.63:8000 /v1 可用）
# - Embedding：远端 OpenAI 兼容服务（203.110.232.133；默认端口 8009，请与机房实际一致）
# - Neo4j：宿主机 bolt；容器内使用 host.docker.internal（compose 已配 extra_hosts）
# 若 Embedding 端口不是 8009，请只改 EMBEDDING_BINDING_HOST 的端口部分。
# =============================================================================

# -----------------------------------------------------------------------------
# 服务（API / WebUI）
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=9621

# -----------------------------------------------------------------------------
# 数据目录
# 当前按「LightRAG 在 Docker 内」填写（与 compose 卷挂载一致）。
# 若在宿主机直接跑 lightrag-server，请改回：./data/rag_storage 与 ./data/inputs
# -----------------------------------------------------------------------------
WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs
LOG_DIR=/app/data/rag_storage

# -----------------------------------------------------------------------------
# LLM —— 本地 Qwen2.5-32B（OpenAI 兼容 /v1，117.88.244.63:8000）
# -----------------------------------------------------------------------------
LLM_BINDING=openai
LLM_BINDING_HOST=http://117.88.244.63:8000/v1
LLM_BINDING_API_KEY=sk-dummy-key
# 本地服务模型 id（与 /v1/models 一致）
LLM_MODEL=/home1/zhaohongyu/.cache/modelscope/hub/models/Qwen/Qwen3-32B
OPENAI_API_KEY=sk-dummy-key
OPENAI_LLM_TEMPERATURE=0
OPENAI_LLM_MAX_TOKENS=8000
# Qwen3 thinking 模式控制：true=在 system_prompt 头部注入 /no_think 关闭思考链
LLM_NO_THINK=true
# 单次 LLM 请求超时（秒）。Worker 层约为 LLM_TIMEOUT×2，默认 180→360s 易在大文档抽取时超时
LLM_TIMEOUT=600

# -----------------------------------------------------------------------------
# Embedding —— 远端 bge-m3（OpenAI 兼容 /v1，机器 203.110.232.133）
# -----------------------------------------------------------------------------
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1 #http://203.110.232.133:8009/v1
EMBEDDING_BINDING_API_KEY=sk-hzgqzsokzhtvppkorxlzduceqckfotaufjxkzgzsikialwmb #sk-dummy-key
# 须与服务端 /v1/models 的 id 一致；Embedding 节点若换端口请改上一行 HOST
EMBEDDING_MODEL=BAAI/bge-m3 #/root/.cache/modelscope/hub/models/BAAI/bge-m3
# bge-m3 密集向量维度为 1024；若服务端实际维度不同，请与部署一致并相应调整
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_SEND_DIM=false

# -----------------------------------------------------------------------------
# Rerank（可选）
# -----------------------------------------------------------------------------
RERANK_BINDING=null

# -----------------------------------------------------------------------------
# 存储 —— 图库 Neo4j（须与下方 NEO4J_URI 可达；不可用 NetworkX 冒充）
# -----------------------------------------------------------------------------
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

# -----------------------------------------------------------------------------
# Neo4j（Bolt）—— 必须与「你实际能连上的」地址一致（在 Neo4j Browser 连接信息或运维处核对）
# - 仅 Docker Compose 内：可用 neo4j://neo4j:7687（compose 会注入；在 Windows 本机 python 直连不要用主机名 neo4j，会 DNS 失败）
# - 本机 Neo4j Desktop / 本机 Docker 映射 7687：bolt://127.0.0.1:7687（或 neo4j://127.0.0.1:7687）
# - 远程 Neo4j：bolt://主机:端口（或 Aura 给的 neo4j+s://…）
# 曾用 117.88.244.63:7687 测试：TCP 通但 Bolt 握手失败，说明该端口不是 Neo4j Bolt；请勿盲填同机其它服务端口。
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j123
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# 其它
# -----------------------------------------------------------------------------
# 与 lightrag/prompt.py 中 {language} 一致：中文抽取/摘要时使用 Chinese
SUMMARY_LANGUAGE=Chinese
ENABLE_LLM_CACHE_FOR_EXTRACT=true

# -----------------------------------------------------------------------------
# 高级 KG 流水线（可选；代码默认 USE_ADVANCED_KG_PIPELINE=true，无需写也能走三阶段）
# 大文档可调下列项；≤0 时阶段 2/3 退回「全文单次」旧行为。
# -----------------------------------------------------------------------------
# USE_ADVANCED_KG_PIPELINE=true
# KG_PIPELINE_STAGE2_CHUNK_BATCH_SIZE=16
# KG_PIPELINE_STAGE3_CHUNK_BATCH_SIZE=16
# KG_PIPELINE_STAGE3_CHUNK_TEXT_MAX_CHARS=8000
# 阶段 3 写入 LLM 前压缩：描述截断、本体每类示例条数、实体子批（解决 32k 上下文 400）
# KG_PIPELINE_STAGE3_PROMPT_ENTITY_DESC_MAX_CHARS=384
# KG_PIPELINE_STAGE3_PROMPT_RELATION_DESC_MAX_CHARS=384
# KG_PIPELINE_STAGE3_PROMPT_ONTOLOGY_MAX_EXAMPLES=6
# KG_PIPELINE_STAGE3_MAX_ENTITIES_PER_LLM_CALL=64
# KG_PIPELINE_MAX_SOURCE_TEXTS=8
