# 本地构建：宿主先生成 lightrag/api/webui（见 scripts/prepare_local_docker_build.ps1）。
#
# 与旧版差异：
# - 不用镜像内 oven/bun（改在宿主或一次性容器里 build WebUI）
# - 不用 ghcr.io/astral-sh/uv（国内/公司网常连不上），改用 Docker Hub 的 python:3.12-slim-bookworm + pip install uv
#
# 若 Docker Hub 也拉不动，请配置 registry mirror / 代理后再 build。

FROM python:3.12-slim-bookworm AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV UV_SYSTEM_PYTHON=1
ENV UV_COMPILE_BYTECODE=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        build-essential \
        pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir uv \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

ENV PATH="/root/.cargo/bin:/root/.local/bin:${PATH}"

RUN mkdir -p /root/.local/share/uv

COPY pyproject.toml .
COPY setup.py .
COPY uv.lock .

RUN --mount=type=cache,target=/root/.local/share/uv \
    uv sync --frozen --no-dev --extra api --extra offline --no-install-project --no-editable

COPY lightrag/ ./lightrag/

RUN test -f lightrag/api/webui/index.html || ( \
        echo "Missing lightrag/api/webui/index.html — run: .\\scripts\\prepare_local_docker_build.ps1 -UseDocker"; \
        exit 1; \
    )

RUN --mount=type=cache,target=/root/.local/share/uv \
    uv sync --frozen --no-dev --extra api --extra offline --no-editable \
    && /app/.venv/bin/python -m ensurepip --upgrade

RUN mkdir -p /app/data/tiktoken \
    && uv run lightrag-download-cache --cache-dir /app/data/tiktoken || status=$?; \
    if [ -n "${status:-}" ] && [ "$status" -ne 0 ] && [ "$status" -ne 2 ]; then exit "$status"; fi

FROM python:3.12-slim-bookworm

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir uv

ENV UV_SYSTEM_PYTHON=1
# 与官方 Dockerfile 一致：运行时必须用 venv 里的 Python，否则缺 httpx 等依赖
ENV PATH="/app/.venv/bin:/root/.local/bin:$PATH"

COPY --from=builder /root/.local /root/.local
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/lightrag ./lightrag
COPY pyproject.toml .
COPY setup.py .
COPY uv.lock .

RUN --mount=type=cache,target=/root/.local/share/uv \
    uv sync --frozen --no-dev --extra api --extra offline --no-editable \
    && /app/.venv/bin/python -m ensurepip --upgrade

RUN mkdir -p /app/data/rag_storage /app/data/inputs /app/data/tiktoken

COPY --from=builder /app/data/tiktoken /app/data/tiktoken

ENV TIKTOKEN_CACHE_DIR=/app/data/tiktoken
ENV WORKING_DIR=/app/data/rag_storage
ENV INPUT_DIR=/app/data/inputs

EXPOSE 9621

ENTRYPOINT ["python", "-m", "lightrag.api.lightrag_server"]
